# --- Channel: Photon/Spectrum ---
# imessage = hosted via project creds (proven in crow). whatsapp-business can use
# Spectrum-hosted config, or direct Meta Cloud API creds below.
CHANNEL_PROVIDER=imessage
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Run the agent over stdin instead of connecting to a live channel (demo fallback).
PA_DRY=0

# --- WhatsApp Business direct (only for CHANNEL_PROVIDER=whatsapp-business) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# --- Brain: any OpenAI-compatible provider ---
# Set LLM_API_KEY/LLM_BASE_URL/LLM_MODEL (Groq, OpenRouter, etc.). If unset,
# OPENROUTER_API_KEY is used with the OpenRouter base URL. No key = the agent
# falls back to its deterministic router (still fully runnable).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Tools: Flights ---
FLIGHT_PROVIDER=stub            # google-flights | amadeus | stub
SERP_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# --- Tools: Google OAuth2 (personal Gmail/Calendar) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
BOSS_CALENDAR_EMAIL=
BOSS_TIMEZONE=America/New_York

# --- Tools: Google Workspace Service Account (alternative) ---
# GOOGLE_SA_KEY_PATH=
# BOSS_CALENDAR_EMAIL=
# BOSS_TIMEZONE=America/New_York

# --- Fallback REST webhook (src/server.js) ---
PHOTON_WEBHOOK_SECRET=
PHOTON_SEND_TOKEN=
PHOTON_SEND_URL=
PHOTON_AGENT_PHONE=
