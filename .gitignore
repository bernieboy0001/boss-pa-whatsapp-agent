node_modules/
.env
.env*
*.log
data/

# Google service-account keys - never commit these
boss-pa-agent-*.json
*-service-account*.json
service-account*.json

# Generated by `npm run build:api` (esbuild output).
# NOTE: `api/` is deliberately NOT ignored. Vercel validates the `functions`
# patterns in vercel.json *before* running buildCommand, so the catch-all must
# exist in the clone or every GitHub auto-deploy fails with
# "pattern api/[...path].js doesn't match any Serverless Functions".
# api/[...path].js is therefore a committed 1-line shim; the real bundle is
# generated into build/ and imported by the shim.
build/

# graft's local graph cache - regenerable, not committed (run `graft build`).
/graft/

.vercel

.vercel
.env*
